{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl attach:*)",
      "Bash(kubectl cp:*)",
      "Bash(kubectl debug:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl run:*)",
      "Bash(kubectl scale:*)"
    ],
    "allow": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(cat /dev/stdin | jq -r '.tool_input.file_path // empty') && [[ \"$file\" == *.tf ]] && terraform fmt \"$file\" || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "av-cli@aviator-plugins": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true
  },
  "extraKnownMarketplaces": {
    "aviator-plugins": {
      "source": {
        "source": "github",
        "repo": "aviator-co/agent-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
